{
  "regions": ["bom1"],
  "redirects": [
    { "source": "/About", "destination": "/about-us", "permanent": true },
    { "source": "/About-Us", "destination": "/about-us", "permanent": true },
    { "source": "/Services", "destination": "/services", "permanent": true },
    { "source": "/Portfolio", "destination": "/portfolio", "permanent": true },
    { "source": "/Testimonials", "destination": "/testimonials", "permanent": true },
    { "source": "/Blog", "destination": "/blogs", "permanent": true },
    { "source": "/Blogs", "destination": "/blogs", "permanent": true },
    { "source": "/Contact", "destination": "/contact", "permanent": true },
    { "source": "/services/SEO", "destination": "/services/seo-services", "permanent": true },
    { "source": "/services/seo", "destination": "/services/seo-services", "permanent": true },
    { "source": "/services/PPC", "destination": "/services/pay-per-click-ads", "permanent": true },
    { "source": "/services/ppc", "destination": "/services/pay-per-click-ads", "permanent": true },
    { "source": "/services/social-media", "destination": "/services/social-media-marketing", "permanent": true },
    { "source": "/services/website", "destination": "/services/website-design-development", "permanent": true },
    { "source": "/services/content", "destination": "/services/content-management", "permanent": true },
    { "source": "/services/google-facebook", "destination": "/services/google-facebook-ads", "permanent": true },
    { "source": "/services/graphic", "destination": "/services/graphic-design", "permanent": true },
    { "source": "/services/branding", "destination": "/services/content-marketing-branding", "permanent": true },
    { "source": "/services/whatsapp", "destination": "/services/whatsapp-marketing", "permanent": true },
    { "source": "/services/influencer", "destination": "/services/influencer-marketing", "permanent": true },
    { "source": "/project/jaycon-gateway-tirupati", "destination": "/projects/jaycon-gateway-tirupati", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api|assets|favicon|robots|sitemap|googlea986774db82d9171).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
